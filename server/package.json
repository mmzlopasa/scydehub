{
  "name": "@scydehub/server",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "secure-json-parse": "^4.1.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
